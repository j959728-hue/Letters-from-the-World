# Copy values into your shell environment or GitHub repository Secrets.
# This file is a template; the program does not auto-load .env files.
OPENAI_API_KEY=
# A Responses API model supporting images + strict structured output (GitHub Variable)
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
KINDLE_EMAIL=
# Set true only after adding EMAIL_FROM to Amazon's Approved Personal Document E-mail List.
APPROVED_SENDER_CONFIRMED=false
MAX_CANDIDATES=300
MAX_FINAL_ITEMS=16
LLM_TOKEN_BUDGET=180000
TIMEZONE=Asia/Shanghai
