# Copy values into your shell environment or GitHub repository Secrets.
# This file is a template; the program does not auto-load .env files.
OPENAI_API_KEY=
# Legacy names remain supported for existing OpenAI setups.
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
# Preferred settings when switching providers. API key goes in GitHub Secrets.
LLM_API_KEY=
LLM_MODEL=
LLM_API_BASE_URL=
# responses or chat_completions
LLM_API_FORMAT=responses
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
KINDLE_EMAIL=
# Set true only after adding EMAIL_FROM to Amazon's Approved Personal Document E-mail List.
APPROVED_SENDER_CONFIRMED=false
MAX_CANDIDATES=500
MAX_FINAL_ITEMS=25
MAX_WEEKLY_ITEMS=25
LLM_TOKEN_BUDGET=400000
TIMEZONE=Asia/Shanghai
